APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=datagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datagent
DATABASE_URL=postgresql://datagent:change-me@127.0.0.1:5432/datagent
# Control-plane tables live in this schema (created by `alembic upgrade head`).
CONTROL_PLANE_SCHEMA=datagent

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530

MINIO_ROOT_USER=datagent
MINIO_ROOT_PASSWORD=change-me

# Existing on-premise OpenAI-compatible endpoint; no public API is used.
MODEL_BASE_URL=http://model-gateway.internal/v1
MODEL_API_KEY=change-me
MODEL_NAME=deepseek-chat

# Protected APIs fail closed (HTTP 503) until OIDC_ISSUER and an audience are set.
OIDC_ISSUER=https://sso.internal/realms/datagent
# Expected `aud` claim of access tokens; defaults to OIDC_CLIENT_ID when empty.
OIDC_AUDIENCE=
OIDC_CLIENT_ID=datagent
OIDC_CLIENT_SECRET=change-me
# Optional; discovered from the issuer's openid-configuration when empty.
OIDC_JWKS_URL=
# Comma-separated OIDC `sub` values granted organization admin on first login.
OIDC_BOOTSTRAP_ADMIN_SUBJECTS=
